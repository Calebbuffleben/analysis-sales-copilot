# ===========================================
# Self-Hosted Deployment Configuration
# ===========================================
# Copy this file: cp .env.example .env
# Then edit .env with your settings

# ===========================================
# Audio Analysis
# ===========================================
# Modes:
# - live: Gemini Live for client audio (best-effort ≤1s after speech end).
#         Host still uses windowed multimodal context. Falls back to multimodal
#         windows when Live is unavailable / over cost guardrail.
# - multimodal: bounded WAV windows via generateContent (rollback / degraded).
# - transcript: AssemblyAI/local STT rollback path.
AUDIO_ANALYSIS_MODE=live
AUDIO_ANALYSIS_CLIENT_INTERVAL_MS=7000
AUDIO_ANALYSIS_HOST_INTERVAL_MS=45000
AUDIO_ANALYSIS_OVERLAP_MS=400

# Gemini Live (AUDIO_ANALYSIS_MODE=live)
LIVE_MODEL=gemini-3.1-flash-live-preview
LIVE_SILENCE_DURATION_MS=250
LIVE_MIN_SPEECH_MS=400
LIVE_MAX_COST_USD_PER_MEETING=3.0
LIVE_ALERT_COST_USD=1.0
LIVE_MAX_CONCURRENT_SESSIONS=20
LIVE_CONTEXT_WINDOW_TOKENS=12000
LIVE_SESSION_ROTATION_MINUTES=2.0
# Host multimodal observe while Live is active (0 = every window; default throttles quota)
LIVE_HOST_OBSERVE_INTERVAL_MS=15000

# Thin LangGraph around the existing Live turn flow (no hot-path checkpoint)
LIVE_LANGGRAPH_ENABLED=true

# One post-publish Gemini call covering SPIN + objection + compliance.
# Disabled by default because it adds Gemini cost/RPM, but never blocks the primary tip.
LIVE_SPECIALIST_ENABLED=false
LIVE_SPECIALIST_MODEL=gemini-2.5-flash
LIVE_SPECIALIST_QUEUE_MAX_SIZE=32
LIVE_SPECIALIST_TIMEOUT_MS=8000
LIVE_SPECIALIST_COOLDOWN_MS=15000
LIVE_SPECIALIST_MIN_CONFIDENCE=0.7
LIVE_SPECIALIST_MAX_AGE_MS=120000
LIVE_SECONDARY_FEEDBACK_ENABLED=true
LIVE_SECONDARY_FEEDBACK_TYPES=risk,objection

# Same allowlist as backend — used when resolving open_url on the Live WS path
PLAYBOOK_URL_ALLOWLIST=

# ===========================================
# Speech-to-Text rollback path
# ===========================================
# Default runtime: AssemblyAI Universal Streaming v3 (real-time WebSocket).
# Get your API key: https://www.assemblyai.com/dashboard/
STT_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=your_api_key_here

# WebSocket host (change only for proxies or custom endpoints)
# ASSEMBLYAI_API_HOST=streaming.assemblyai.com

# Model and audio format (must match incoming Meet audio: 16 kHz mono PCM)
ASSEMBLYAI_SPEECH_MODEL=u3-rt-pro
ASSEMBLYAI_SAMPLE_RATE=16000

# Turn formatting: formatted finals improve readability in logs
ASSEMBLYAI_FORMAT_TURNS=true

# Enable partial transcripts for early feedback (requires partial analysis below).
# Note: continuous partials during long turns are applied via UpdateConfiguration
# after the session Begin message — not as a URL query param.
ASSEMBLYAI_CONTINUOUS_PARTIALS=true

# Tab-audio / meet-remote turn tuning (more aggressive than host mic)
# ASSEMBLYAI_TAB_AUDIO_VAD_THRESHOLD=0.65
# ASSEMBLYAI_TAB_AUDIO_MAX_TURN_SILENCE_MS=800

# Partial-turn early analysis (participant / tab-audio streams only)
PARTIAL_ANALYSIS_ENABLED=true
PARTIAL_STABLE_MS=600
PARTIAL_WORD_STABLE_MS=300
PARTIAL_GROWTH_WINDOW_MS=400
PARTIAL_MIN_WORDS=5
PARTIAL_COOLDOWN_MS=3000
PARTIAL_MIN_CONFIDENCE=0.7

# Dev/solo testing: publish feedback from host mic (do NOT enable in production)
# FEEDBACK_ALLOW_HOST_PUBLISH=true

# Seller Rooms acoustic routing
# ACOUSTIC_ROUTING_ENABLED=true
# ACOUSTIC_SHADOW_MODE=false   # true = classify+metrics only, no observe/analyze change

# Session lifecycle (close idle streams to avoid billing on orphaned connections)
ASSEMBLYAI_STREAM_IDLE_TIMEOUT_MS=30000
ASSEMBLYAI_RECONNECT_LIMIT=2
ASSEMBLYAI_CONNECT_TIMEOUT_SECONDS=10.0
ASSEMBLYAI_TERMINATION_TIMEOUT_SECONDS=2.0

# Optional turn-detection tuning (omit to use AssemblyAI defaults)
# ASSEMBLYAI_END_OF_TURN_CONFIDENCE_THRESHOLD=0.5
# ASSEMBLYAI_MIN_TURN_SILENCE_MS=160
# ASSEMBLYAI_MAX_TURN_SILENCE_MS=2400
# ASSEMBLYAI_VAD_THRESHOLD=0.5
# ASSEMBLYAI_KEYTERMS_PROMPT=product names, jargon, participant names

# Legacy local fallback (faster-whisper). Requires STT_PROVIDER=local and Whisper
# deps in the image; not recommended for normal local dev.
# STT_PROVIDER=local
# TRANSCRIPTION_MODEL_SIZE=small
# TRANSCRIPTION_DEVICE=cpu
# TRANSCRIPTION_COMPUTE_TYPE=int8
# WHISPER_VAD_FILTER=true
# WHISPER_DEFAULT_LANGUAGE=pt
# STT_PROCESS_WORKERS=0
# PRELOAD_ML_MODELS=true

# ===========================================
# LLM Configuration
# ===========================================

# Option 1: Gemini (Google AI Studio — Free tier: 15 RPM, 1M tokens/day)
# Get your API key: https://aistudio.google.com/app/apikey
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash

# Single-key mode (backwards-compatible) — one key only, no commas
GEMINI_API_KEY=your_api_key_here

# Multi-key mode (recommended for production scale). See docs/gemini-multi-key-pool.md
# Capacity ≈ number_of_keys × GEMINI_RPM_LIMIT RPM; sticky routing by tenant_id.
# GEMINI_API_KEYS=your_api_key_1,your_api_key_2,your_api_key_3
#
# Do NOT put multiple keys in GEMINI_API_KEY (comma-separated). Use
# GEMINI_API_KEYS instead. If GEMINI_API_KEYS is unset, commas in
# GEMINI_API_KEY are split automatically (with a startup warning).
# GEMINI_RPM_LIMIT is per key. Keep it below your Google tier limit.
GEMINI_RPM_LIMIT=12
GEMINI_RPM_WINDOW_SEC=60
GEMINI_KEY_ROUTING=tenant

# Option 2: Ollama (100% free, local — requires Ollama container running)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_TIMEOUT=30

# ===========================================
# Backend gRPC Feedback URL
# ===========================================
# If backend is on same server:
GRPC_FEEDBACK_URL=localhost:50052
# If backend is on different server:
# GRPC_FEEDBACK_URL=your-backend-server.com:50052

# --- Auth for gRPC feedback (pick ONE approach) ---
#
# A) Manual JWT (expires; rotate by hand or script):
# BACKEND_SERVICE_TOKEN=<eyJ... from POST /auth/service-token>
#
# B) Automatic renewal (recommended): same SERVICE_BOOTSTRAP_KEY as the backend
#    + HTTP base URL. Python calls POST /auth/service-token before expiry
#    (no manual BACKEND_SERVICE_TOKEN). Tenant isolation remains per gRPC event
#    via x-tenant-id; service tokens are not scoped to a tenant.
# BACKEND_HTTP_BASE_URL=http://localhost:3001
# SERVICE_BOOTSTRAP_KEY=<same value as backend SERVICE_BOOTSTRAP_KEY>
# Optional: SERVICE_TOKEN_MINT_TTL_SECONDS=3600   # max 3600 per backend

# ===========================================
# Direct Desktop WebSocket Gateway (backend bypass)
# ===========================================
# Realtime bypass: desktop streams PCM straight to this service and
# receives feedback on the same WS server, skipping the NestJS hop.
# Backend keeps receiving feedback via gRPC for persistence/dashboard.
#
# O gateway WS escuta na PORT pública (Cloud Run injeta PORT; local default 8765).
# GET /health na mesma PORT para probes. gRPC de áudio em GRPC_PORT (50051).
# Cloud Run feedback: GRPC_FEEDBACK_URL=https://<meet-backend.run.app>
#
# DESKTOP_WS_ENABLED=true
# DESKTOP_WS_COALESCE_MS=100   # opcional, default 100
# GRPC_FEEDBACK_URL=localhost:50052
# GRPC_FEEDBACK_USE_TLS=false  # true / inferido de https:// ou :443
#
# JWT validation (mesmas chaves do backend):
# JWT_PUBLIC_KEY=...  (prod RS256)
# JWT_SECRET=...      (dev HS256)
# Se ambos estiverem definidos, o gateway lê `alg` do header e usa somente a
# chave correspondente (RS256 -> public key; HS256 -> secret).
# JWT_ISSUER=meet-backend
# JWT_AUDIENCE=meet-platform

# ===========================================
# Logging
# ===========================================
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Set to true for detailed feedback trace logs
# FEEDBACK_TRACE_DEBUG=true
